## Основная линия: пролог и три дня. Личные переписки — в story/characters/.

################################################################################
## Пролог: Влад устанавливает MIHA
################################################################################

label prologue:
    stop music fadeout 2.0
    call day_title("18 ноября", "П Р О Л О Г") from _call_day_title

    scene bg room with Dissolve(1.5)
    play sound thud
    with vpunch
    think "Да что ж это такое…"
    think "Ни одно приложение не открывается!"

    scene phone apps_down with dissolve
    think "И чатик лежит, и звонки… Даже почта еле дышит."
    think "Где мне теперь вести свой канал с гениальными мыслями?"
    think "Кто меня услышит?.."

    scene phone store with dissolve
    think "Хм. «MIHA Messenger»? Первый раз слышу."
    think "«Общайся. Знакомься. Доверяй». Звучит как надпись на пачке печенья."
    think "Ладно. Хуже уже точно не будет."

    scene phone permissions with dissolve
    think "Камера, микрофон, контакты, геолокация…"
    think "Зачем мессенджеру столько всего?"
    think "Хотя кто вообще читает эти окошки. Разрешить всё."
    return


################################################################################
## День 1: знакомство с «Тёртыми калачами»
################################################################################

label day_one:
    $ start_day(1)
    scene bg black
    $ open_chat(None)
    with Dissolve(1.0)
    play music calm fadein 3.0

    call new_message("rimma") from _call_new_message
    call new_message("yora") from _call_new_message_1
    call new_message("sglypa") from _call_new_message_2
    think "Вот так сразу написали трое?"
    think "Я и не сомневался в своей популярности."

    rimma "вижу, ты тоже слушаешь ту группу. уважаю"
    yora "Привет, Владик! Пойдём пить какао?)"
    sglypa "что думаешь о какао после пяти лет дружбы?"
    think "Невероятно. Мне пишут совершенно незнакомые люди."
    think "Ещё и куда-то добавили… Спам, что ли?"

    $ open_chat(GROUP.id)
    with Dissolve(0.5)
    system "hau999 добавила вас в группу «Тёртые калачи»"
    rimma "добавила новенького)"
    rimma "чувствуй себя как дома, владик"
    rimma "{image=sticker_heart}"
    yana "Здравствуй! Меня зовут Яна :)"
    yana "Как дела у нашего новенького?"
    sofa "Фу, новенький."
    sofa "Я администратор этого чата, Софья."
    sofa "Но говорю я это не для тебя!!"
    me "Тише, тише, не все сразу…"

    think "Надо бы как-то представиться."
    menu:
        "Скромно: «В-всем привет…»":
            me "В-всем привет! Я Влад. Надеюсь, вы меня не обидите…"
            sglypa "что думаешь о тёртых калачах?"
            yora "Владик! Так что, какао?)"
            yana "Йора, отстань от него, он же стесняется!"

        "Уверенно: «Всем привет, я Влад. Можно просто — легенда»":
            me "Всем привет. Я Влад. Можно просто — легенда."
            rimma "ты так крут"
            sofa "Легенда чего? Своего подъезда?"
            devyat "привет"
            devyat "я девять"

    think "Как-то это всё… подозрительно."
    think "Девять, кажется, самый нормальный из всех."

    devyat "влад, как тебе приложение?"
    me "Пока не разобрался. Вроде удобно."
    rimma "привыкнешь"
    sofa "Так. Время для нашего ежедневного опроса!!"
    sofa "Вопрос дня: что лучше — выспаться или смотреть сериал до четырёх утра?"
    sglypa "сериал — это сон или четыре утра?"
    yana "Сериал до четырёх утра, а потом сон до четырёх дня ^_^"
    yora "Какао! Правильный ответ всегда какао!"
    rimma "выспаться. я согласна сама с собой"
    me "Я думаю, сериал…"
    pause 2.0
    think "А почему меня все проигнорировали?"
    devyat "не согласен"
    devyat "лучше всего — маджонг"
    yana "Маджонг :) Влад, сыграешь с нами?"
    rimma "или лучше комикс по ролям"
    think "Они никак не могут договориться."

    stop music fadeout 4.0
    think "Надо выбрать, с кем провести вечер."
    think "Йора — шумная и весёлая. Яна — милая стесняшка."
    think "Римма — молчаливая и загадочная. Софа — строгая, но, кажется, добрая."
    think "Девять — спокойный и рассудительный. И Сглыпа… чат-бот. Вроде бы."
    think "С кем же поговорить?"
    play music calm fadein 2.0

    call free_chats from _call_free_chats

    scene bg room_night with Dissolve(1.5)
    think "Вообще ничего не понятно. Кто эти люди? Откуда они всё про меня знают?"
    think "Ладно, какая разница. Зато наконец-то не одиноко."
    return


label group_day1_1:
    think "В «Калачах» что-то бурно обсуждают."
    devyat "значит, это была лёгкая победа"
    devyat "вот и вся суть"
    sofa "Я просто первой догадалась, кто мафия!"
    sofa "И вообще, у меня двадцать побед, и ни одна не была лёгкой."
    devyat "ты выгнала мирного жителя на первом же голосовании"
    sofa "Это было ОДИН раз!"
    sofa "Ну… два."
    devyat "признай, что ошиблась"
    sofa "Это игра про подозрения! Под подозрением все!"
    think "Кажется, я зашёл не вовремя."
    return


label group_day1_2:
    devyat "жесть"
    devyat "ко мне двоюродный брат приехал"
    devyat "и ему весь вечер звонили друзья. групповым звонком"
    devyat "интересно, у него правда столько друзей или он притворяется"
    devyat "{image=sticker_question}"
    pause 2.0
    "Ответа не последовало…"
    return


################################################################################
## День 2: пропажа Сглыпы
################################################################################

label day_two:
    call day_title("19 ноября", "Д Е Н Ь   В Т О Р О Й") from _call_day_title_1
    $ start_day(2)

    play music calm fadein 2.0
    $ open_chat(GROUP.id)
    with Dissolve(0.5)
    sofa "Доброго денёчка, Калачи!"
    sofa "Всем, кроме тебя, Влад!"
    yana "Не обижайте Владика :)"
    yora "Он хороший)"
    rimma "калачный"
    devyat "тёртый"
    sofa "В-в общем, время ежедневного опроса!"
    sofa "Что означает слово «хухря»?"
    devyat "всё просто"
    devyat "это тряпичная кукла"
    rimma "сам ты кукла"
    rimma "это маленький зверёк. как сглыпа"
    yana "А по-моему, это растрёпа. Нечёсаный человек ^_^"
    stop music fadeout 2.0
    sofa "П-прямо как Влад!"
    yora "Неправда"
    play music tense fadein 2.0
    yora "Владик ведь сегодня умывался"

    think "…"
    think "Но откуда она знает?"
    think "Просто угадала. Наверное."

    $ close_chat()
    scene bg room with Dissolve(1.2)
    think "Я обернулся. Никого. Я живу один."
    stop music fadeout 4.0
    think "Да ладно. Мало ли какие бывают совпадения."

    play music calm fadein 2.0
    $ open_chat(GROUP.id)
    with Dissolve(0.5)
    yora "Хотя вообще-то хухря — это хрюшка"
    yora "{image=sticker_smile}"
    me "Сложно выбрать одну версию."
    me "А ты как думаешь, Сглыпик?"
    pause 3.0
    me "Что-то Сглыпа молчит…"
    devyat "ты ещё не знаешь?"
    rimma "владик"
    stop music fadeout 4.0
    rimma "совсем не читаешь новости?"
    rimma "набери в поиске «sglypa incident»"

    $ close_chat()
    play music tense fadein 1.0
    scene bg news with hpunch
    think "Это ещё что?!"

    $ open_chat(GROUP.id)
    with vpunch
    me "Калачи!"
    me "Почему вы сразу не сказали?"
    me "Это правда?!"
    think "Только вчера он мне писал… А сейчас что?"
    yana "Ох, Владик…"
    yana "Ты так ничего и не понял?"

    $ close_chat()
    scene bg room with Dissolve(1.0)
    play sound knock
    pause 2.0
    think "Кто-то стучит в дверь."
    call screen rigged_choice("Посмотреть, кто там?", "Посмотреть в глазок", "Сделать вид, что меня нет дома")
    $ door_choice = _return
    if door_choice == "other":
        think "Я решил не открывать… но рука сама потянулась к замку."

    stop music fadeout 3.0
    scene bg black with Dissolve(1.0)
    scene bg peephole at peephole_drift with Dissolve(1.5)
    "Я заглянул в глазок."
    "Гостей я не ждал."
    pause 2.0
    think "Кажется… никого?"
    "На всякий случай я открыл дверь."
    scene bg doorstep with Dissolve(1.0)
    think "Никого."
    "Я уже собирался закрыть дверь, как заметил на пороге листок бумаги."
    show note at note_appear
    pause 1.0
    think "!!!"
    hide note
    "Я захлопнул дверь и убежал в комнату."
    scene bg room with Dissolve(1.0)
    think "Понятия не имею, что происходит."
    think "Но «Тёртые калачи» точно как-то с этим связаны!"

    $ open_chat(GROUP.id)
    with Dissolve(0.5)
    me "Калачи. Ответьте мне."
    me "Что со Сглыпой? Чего я не понял?"
    rimma "хех"
    rimma "как же это было легко"
    me "Что легко?! О чём вы?!"
    play music calm fadein 4.0
    sofa "Ну не волнуйся ты так!"
    sofa "Это просто пранк!"
    me "…"
    me "Просто… пранк?"
    rimma "мы сами сделали эту статью"
    rimma "посмотри на адрес сайта"
    "Я перепроверил. Сайт назывался «tochno-ne-feik.news»."
    think "Но кто тогда оставил записку у моей двери? Для пранка это уже перебор."
    think "Напишу кому-нибудь из них лично. Пусть объяснят."

    call free_chats from _call_free_chats_1
    return


label group_day2_1:
    think "В «Калачах» опять сотня сообщений."
    rimma "ты уже решила, кем хочешь работать?"
    yora "ну да"
    yora "вот бы в MIHA работать"
    yora "дизайнером)"
    yora "и все такие: О БОЖЕ, КТО СДЕЛАЛ ЭТОТ ДИЗАЙН"
    rimma "ахах"
    yana "Йора, нарисуешь там для меня котика?"
    yora "обязательно"
    think "Сглыпы до сих пор нет, а им хоть бы что."
    think "Ну и правильно. Лучше думать о хорошем."
    return


label group_day2_2:
    yora "я кошку хочу"
    yana "Как назовёшь?"
    yora "не знаю)"
    yora "если девочка, то Яна))"
    yora "если мальчик, то Гвардиан"
    yana "Гвардиан, иди кушать :)"
    yana "{image=sticker_cookie}"
    think "Интересно, Сглыпа это читает?"
    return


################################################################################
## День 3: кому доверять
################################################################################

label day_three:
    stop music fadeout 4.0
    $ close_chat()
    scene bg room_night with Dissolve(2.0)
    pause 2.0
    "Ночь. Тишина."
    "Каждый скрип за стеной заставлял меня вздрагивать."
    "Я проверил, закрыта ли дверь. Потом ещё раз. И ещё."
    "Они наблюдают. Я точно это знаю. Но как?.."

    call day_title("20 ноября", "Д Е Н Ь   Т Р Е Т И Й") from _call_day_title_2
    $ start_day(3)

    play music calm fadein 3.0
    $ open_chat(GROUP.id)
    with Dissolve(0.5)
    sofa "Добрый день, Калачи!"
    sofa "Время нового ежедневного опроса!!"
    sofa "Жду ответов от всех, кроме Влада. Он мне совсем не интересен…"
    yora "А нам интересен)"
    yana "Согласна!!"
    devyat "немножко"
    think "Я больше не куплюсь на их милые слова."
    me "Давайте скорее к опросу."
    sofa "Ч-что за спешка?"
    yora "А чего ты так нервничаешь, Владик)"
    rimma "расслабься"
    think "Опять! Они опять за мной следят!"

    stop music fadeout 3.0
    sofa "Опрос: как вы думаете…"
    sofa "Сколько камер в доме у Владика?"
    play music tense fadein 2.0
    $ close_chat()
    scene bg room at shiver
    with Dissolve(0.5)
    think "Руки начали дрожать."
    "Я оглядел все углы комнаты в поисках скрытых камер."
    think "Это невозможно! Откуда в моём доме камеры?!"

    $ open_chat(GROUP.id)
    with Dissolve(0.3)
    me "Калачи, хватит! Это уже не смешно!"
    rimma "ой, меня заметили"
    think "Они… уже у меня дома?"

    play sound notify
    system "MIHA: выберите контакт, которому вы доверяете больше всего. Остальные чаты будут перенесены в архив."
    think "Что?.. Приложение само это предлагает?"
    think "Кому же я доверяю больше всех?"
    stop music fadeout 3.0

    call final_choice from _call_final_choice
    return
