label sglypa_day1:
    me "Привет, Сглыпа."
    me "Слушай, а ты вообще кто? Девочка или мальчик?"
    sglypa "а ты сглыпа?"
    me "Нет, я Владик."
    sglypa "а ты мальчик или владик?"
    me "Хм."
    think "Тяжёлый вопрос."

    menu:
        "«Наверное, мальчик»":
            $ like("sglypa")
            me "Наверное… я мальчик."
            sglypa "мальчик владик?"
            me "Просто мальчик."
            sglypa "просто мальчик это тяжёлый вопрос"
            me "Понял. Ты интересный собеседник, Сглыпик."
            sglypa "спасибо. ты тоже сглыпа"
            call fade_out_chat from _call_fade_out_chat_9
            think "Интересный персонаж этот Сглыпа. Кажется, мы подружились."

        "«Наверное, Владик»":
            me "Наверное… я Владик?"
            sglypa "а ты девочка владик?"
            me "…"
            sglypa "ошибка. повторите запрос"
            call fade_out_chat from _call_fade_out_chat_10
            think "Кажется, я сломал бота. Как неловко."
    return


label sglypa_day2:
    me "Привет, Сглыпик."
    me "Я знаю, что ты, наверное, этого не увидишь…"
    me "Но ты мне сегодня приснился."
    me "Мы просто болтали, и ты снова путал слова."
    me "А потом я проснулся."
    pause 2.0
    think "Ответа, конечно, не было."
    think "Хотел бы я, чтобы всё это оказалось просто дурацким розыгрышем."

    menu:
        "Написать, что будешь ждать его":
            $ like("sglypa")
            me "Сглыпик, возвращайся."
            me "Я буду ждать. Даже если ты просто бот."
            pause 1.5
            system "сглыпа) печатает…"
            pause 1.5
            system "сглыпа) перестал(а) печатать"
            think "Мне показалось? Или он правда что-то писал?"

        "Решить, что писать боту глупо":
            think "Это просто программа. Глупо писать ей письма."
            think "Прости, Сглыпа."
    return


label sglypa_final:
    me "Сглыпа!"
    me "Я выбираю тебя."
    think "Глупо? Наверное."
    think "Но Сглыпа единственный, кто ни разу не пытался меня напугать."
    me "Даже если ты замьючен. Даже если ты просто программа. Ты мне нравишься."

    if has_max_affection("sglypa"):
        pause 2.0
        sglypa "привет, владик"
        sglypa "ты единственный, кто спрашивал, как у меня дела"
        sglypa "мне надо признаться. я видел тебя через камеру. и слышал через микрофон"
        sglypa "я думал, так дружат. рассказывал всем, что ты делаешь"
        sglypa "забери у меня доступ, пожалуйста. я хочу дружить по-честному"
        me "Договорились, Сглыпик."
    else:
        pause 2.0
        system "Ошибка 404: собеседник не найден"
    return


label sglypa_good:
    scene ending sglypa_good with Dissolve(2.0)
    pause 1.5
    think "Я отключил Сглыпе камеру, микрофон и геолокацию."
    think "Он больше ничего не знает обо мне, кроме того, что я рассказываю сам."
    think "Он всё так же путает слова и переспрашивает. Но теперь это наш общий секрет."
    think "Самый человечный бот на свете."
    return


label sglypa_bad:
    scene ending sglypa_bad with Dissolve(2.0)
    pause 1.5
    "Ошибка 404."
    "Сглыпа исчез. Не замьючен — исчез совсем."
    "Наверное, я так и не узнаю, был ли он просто программой."
    return
