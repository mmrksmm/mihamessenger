label yora_day1:
    me "Привет, Йора!"
    me "Так что там с какао?"
    yora "Ещё спрашиваешь"
    yora "{image=sticker_smile}"
    yora "Я уже третью кружку допиваю…"
    me "Третью? Ты как вообще?"
    yora "Отлично) просто очень бодро)))"
    yora "Владик, скинь фоточку)"
    me "{image=sticker_star}"
    yora "Это звезда"
    me "Это я. В душе."
    yora "Ахаха"
    yora "Ну приходи на какао, раз ты звезда)"
    think "Кажется, настал момент показать характер."

    menu:
        "«Уже бегу! Ставь чайник, я через пять минут!»":
            me "Уже бегу! Ставь чайник, я через пять минут!"
            yora "Эээ"
            yora "Мы вообще-то в разных городах, Владик"
            yora "И я тебя знаю один день"
            yora "Давай как-нибудь потом)"
            call fade_out_chat from _call_fade_out_chat_18
            think "Кажется, я поторопился."

        "Написать ей стишок про какао":
            $ like("yora")
            me "Йора, ты как какао в ноябре —"
            me "Тёплая, сладкая и немного слишком бодрая."
            yora "А ты поэт"
            yora "Мне такие нравятся)"
            yora "Пиши ещё, я сохраню в избранное"
            call fade_out_chat from _call_fade_out_chat_19
            think "Как легко порадовать человека."
    return


label yora_day2:
    me "Йора, привет. Мне нужно с тобой поговорить."
    yora "Какао захотелось?)"
    me "Нет. Что случилось со Сглыпой?"
    me "Если это пранк, почему он не пишет в «Калачи»?"
    yora "Так мы его замьютили, чтобы тебя напугать"
    yora "Владик, ну ты чего, это же шутка)"
    think "Она явно пытается заговорить мне зубы."
    think "Осталось спросить про записку."

    menu:
        "Мягко расспросить":
            me "Й-йора… я тут хотел спросить…"
            yora "Что ты там мямлишь?"
            yora "Ой, у меня какао остывает"
            yora "Потом напишу!"
            call fade_out_chat from _call_fade_out_chat_20
            think "Не получилось."

        "Спросить прямо":
            $ like("yora")
            me "Йора, ответь честно."
            me "Кто оставил мне записку про Сглыпу?"
            yora "Какую записку?"
            yora "Я вообще в другом городе)"
            me "А откуда ты знаешь, в каком городе я?"
            yora "Ну…"
            yora "Сглыпа рассказывал. Он всем про всех рассказывает"
            yora "Поэтому мы его и замьютили, если честно"
            call fade_out_chat from _call_fade_out_chat_21
            think "Почти ничего не узнал. Но про записку она, похоже, правда не знает."
            think "И что значит «Сглыпа всем про всех рассказывает»?"
    return


label yora_final:
    me "Йора!"
    me "Я выбираю тебя."
    yora "Чтобы попить какао?"
    yora "Я видела, у тебя на полке новая пачка) так мило, что ты её для меня купил"
    think "Да. Йора — она такая."
    think "Громкая, смешная и вечно на трёх кружках какао. Но именно этим она мне и нравится."
    me "Йора, мне не нужны другие Калачи. Я хочу дружить с тобой."
    yora "Владик…"
    yora "Это так…"

    if has_max_affection("yora"):
        yora "мило"
        yora "Знаешь, ты первый, кто написал мне стих"
        yora "Давай встретимся, когда я приеду? Какао с меня)"
        me "Договорились!"
    else:
        play music tense
        yora "кринжово"
        yora "Прости, Владик, но я писала тебе просто так, от скуки"
        yora "Пока-пока)"
        system "Yora_cocoa теперь не в сети"
    return


label yora_good:
    scene ending yora_good with Dissolve(2.0)
    pause 1.5
    think "Ответов на свои вопросы я так и не получил."
    think "Зато через месяц Йора приехала в мой город."
    think "Мы обошли все кофейни и выбрали лучшее какао."
    think "Иногда ответы не так важны, как человек, с которым их ищешь."
    return


label yora_bad:
    scene ending yora_bad with Dissolve(2.0)
    pause 1.5
    "После её ответа я ещё долго смотрел на надпись «не в сети»."
    "Я так и не узнал, куда пропал Сглыпа и что вообще происходит в этом чате."
    "Я просто пил какао. Один."
    return
