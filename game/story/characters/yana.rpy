label yana_day1:
    me "Привет, Яна! Какие планы на вечер?"
    yana "Владик?! Ты написал именно мне? Вот это да!!"
    yana "Я так рада ^_^"
    me "Может, в маджонг?"
    yana "Можем просто помолчать :)"
    yana "Дай сначала порадоваться!"
    think "Какие тёплые слова. Может, Калачи — мой новый дом?.."
    me "Слушай, а ты когда-нибудь моггала?"
    yana "Что-что я делала?"
    yana "Это что-то про мою внешность?"
    think "О нет. Надо выкручиваться."

    menu:
        "Дать ей совет по внешности":
            me "Ну, ты не страшная, но и не модель."
            me "Держи осанку, пей воду, спи восемь часов, и через год всё изменится!"
            yana "…"
            pause 2.0
            me "Яна?.."
            call fade_out_chat from _call_fade_out_chat_15
            "Яна больше не отвечала."
            think "Кажется, совет был лишним. Совсем лишним."

        "Объяснить, что это просто мем, и посмеяться вместе":
            $ like("yana")
            me "Да это просто мем! Ничего плохого, честно."
            yana "Ааа, вот оно что. Какая я глупая ^_^"
            yana "Тогда я тоже немножко моггаю :)"
            yana "А хочешь, расскажу свой любимый анекдот? Обещаешь смеяться?"
            me "Конечно, давай!"
            yana "Встречаются два мессенджера. Один говорит: «Ты чего такой загруженный?»"
            yana "А второй: «Да у меня обновление»."
            me "{image=sticker_smile}"
            call fade_out_chat from _call_fade_out_chat_16
            "Это был чудесный вечер."
    return


label yana_day2:
    think "Яна писала, что я чего-то до сих пор не понял. Но чего?"
    me "Яна, чего я не понимаю?"
    me "Где Сглыпа?"
    yana "{image=sticker_question}"
    yana "Я не такая, как остальные Калачи!!"
    me "Я скучаю по Сглыпе."
    yana "Йора его замьютила, он теперь как будто на обеде :)"
    yana "Но зачем тебе Сглыпа, когда есть я?"
    yana "Не вешай нос, Владик! Всё будет хорошо!"
    think "Яна умеет поддержать в тревожный момент."
    yana "Хочешь, поищем ответы вместе? Я помогу!"

    menu:
        "Согласиться":
            $ like("yana")
            me "Звучит отлично. Давай!"
            yana "Ура!!"
            call fade_out_chat from _call_fade_out_chat_17
            think "Следующие пару часов мы разгадывали загадки в какой-то онлайн-игре."
            think "Яна всё время рассказывала Калачам о каждом моём ходе."
            think "К правде я не приблизился, но Яна была довольна."

        "Отказаться":
            me "Прости, сегодня я сам по себе."
            yana "Очень печально…"
            yana "Опять ты со своим Девятью, да?"
            yana "Ничего. Я приму тебя любым."
            $ close_chat()
            scene bg room with Dissolve(1.2)
            "Вечером я наконец-то решил отдохнуть и включил музыку погромче."
            $ open_chat("yana")
            with hpunch
            yana "Владик, это что за песня у тебя играет?"
            yana "Я такую не знаю!"
            $ close_chat()
            scene bg room with hpunch
            think "Стоп. Откуда она знает, что у меня играет?"
            think "Неужели через микрофон?.. Я же сам разрешил ему всё."
    return


label yana_final:
    me "Яна!"
    me "Я выбираю тебя."
    yana "Владик?.."
    yana "Ты серьёзно?.."
    think "Она милая. Добрая. Всегда меня поддерживает."
    think "Пусть и немного навязчиво."
    me "Мне не нужны остальные. Ты единственная, кто был добр ко мне с первого дня."

    if has_max_affection("yana"):
        yana "Я… я тоже должна кое в чём признаться"
        yana "Это я рассказывала всем, что ты делаешь. Мне говорил Сглыпа, а я пересказывала"
        yana "Я думала, это весело. Прости"
        yana "Давай вместе выясним, откуда он всё знает?"
        me "Давай."
    else:
        yana "Ой…"
        yana "Владик, ты хороший, но…"
        yana "Мне надо подумать"
        pause 2.0
        system "Сообщение прочитано"
    return


label yana_good:
    scene ending yana_good with Dissolve(2.0)
    pause 1.5
    think "Мы с Яной просидели в настройках MIHA всю ночь."
    think "Оказалось, Сглыпа — встроенный помощник приложения. Тот самый, которому я «разрешил всё»."
    think "Мы отключили ему камеру и микрофон. А потом ещё долго болтали — уже просто так."
    think "Теперь Яна — мой свет в окошке. В самом хорошем смысле."
    return


label yana_bad:
    scene ending yana_bad with Dissolve(2.0)
    pause 1.5
    "«Прочитано». Больше ничего."
    "Я заходил в чат каждые пять минут, но Яна так и не ответила."
    "Иногда мне казалось, что за мной кто-то наблюдает. Наверное, просто казалось."
    return
