label devyat_day1:
    me "Привет. Ты показался мне самым адекватным. Поболтаем?"
    devyat "привет"
    devyat "ну давай понемногу"
    me "Скучаешь по старым мессенджерам? Как думаешь, этот тоже скоро сломается?"
    devyat "завтра может"
    devyat "есть ещё вариант"
    devyat "что не завтра"
    think "Девять очень осторожен. Надо направить разговор в позитивное русло."
    me "А мне нравится MIHA. Всё привычно, и сразу столько новых знакомых."
    devyat "есть такое"
    devyat "{image=sticker_smile}"

    menu:
        "Наступательная стратегия: позвать его в маджонг":
            $ like("devyat")
            me "Слушай, научишь меня играть в маджонг?"
            devyat "о, куда торопишься"
            devyat "но мне нравится такой подход"
            devyat "уверенность — это хорошо"
            devyat "у меня, кстати, проблема"
            devyat "уже четыре года ищу, кому отдать свою коллекцию плюшевых игрушек"
            think "Я взглянул на плюшевого монстрика у себя на полке."
            think "А ведь он и правда давно мне не нужен."
            call fade_out_chat from _call_fade_out_chat
            think "Через пару минут монстрик отправился в коробку «отдать в хорошие руки»."
            $ vlad_threw_out_toy = True

        "Оборонительная стратегия: «Девчонки в этом чате все одинаковые»":
            me "Слушай, а девчонки в этом чате все одинаковые, да?"
            devyat "чего?"
            devyat "это просто стереотип"
            devyat "люди разные. даже в нашем странном чате"
            think "Полный провал. Первые знакомства — это сложно."
            devyat "будь осторожен, влад"
            call fade_out_chat from _call_fade_out_chat_1
            think "Больше Девять в тот вечер ничего не написал."
    return


label devyat_day2:
    think "Точно. Девять. Ему я могу довериться."
    me "Девять? Ты тут?"
    devyat "здравствуй"
    devyat "рад, что ты написал именно мне"
    me "Что происходит? Что со Сглыпой?"
    devyat "у меня есть одна теория"
    devyat "но обещай, что отнесёшься к ней серьёзно"
    me "Обещаю. Что угодно, лишь бы узнать правду."

    menu:
        "Довериться Девяти":
            $ like("devyat")
            me "Я слушаю."
            play music tense fadein 3.0
            devyat "смотри"
            devyat "мессенджер появился ровно тогда, когда сломались все остальные"
            devyat "при установке он просит доступ вообще ко всему"
            devyat "а потом в чате появляется бот, который всё про всех знает"
            devyat "думаю, MIHA — это чей-то эксперимент. собирают данные"
            devyat "и, возможно, кто-то из нас тоже не совсем человек"
            me "Ты собрал пазл, Девять. Всё сходится…"
            stop music fadeout 4.0
            devyat "а со сглыпой, кстати, правда пранк"
            devyat "просто он слишком много болтал"
            call fade_out_chat from _call_fade_out_chat_2
            think "Девять сложил пазл у меня в голове… а потом разобрал обратно."
            play music calm fadein 2.0

        "«Давай не сейчас, мне страшно»":
            me "Прости. Я не готов."
            devyat "понимаю"
            devyat "правда иногда страшнее лжи"
            call fade_out_chat from _call_fade_out_chat_3
            think "Я лёг спать, так ничего и не узнав."
    return


label devyat_final:
    me "Девять!"
    me "Я выбираю тебя."
    devyat "серьёзно?"
    think "Девять — единственный, кто с самого начала говорил со мной по-человечески."
    think "Без шуток про камеры и пранков."
    me "Ты единственный, кому я доверяю. Давай вместе разберёмся, что за MIHA такая."

    if has_max_affection("devyat"):
        devyat "давно ждал, что ты это скажешь"
        devyat "у меня уже есть план"
        devyat "сначала забираем у приложения все разрешения"
        devyat "потом пишем разработчикам. официально"
        me "Звучит как начало детективного сериала."
        devyat "так и есть, напарник"
    else:
        devyat "влад, ты хороший"
        devyat "но я тебе тогда сказал: будь осторожен"
        devyat "а ты всё равно разрешил приложению всё"
        devyat "удачи"
        system "yanepoel покинул(а) чат"
    return


label devyat_good:
    scene ending devyat_good with Dissolve(2.0)
    pause 1.5
    think "Мы с Девятью разобрались во всём: MIHA действительно собирала лишние данные, а Сглыпа ими «делился»."
    think "Разработчики извинились и выпустили обновление."
    think "А мы открыли маленькое детективное агентство. Пока у нас одно дело — пропавший кот соседки."
    think "Но это только начало, напарник."
    return


label devyat_bad:
    scene ending devyat_bad with Dissolve(2.0)
    pause 1.5
    "Девять ушёл из чата."
    "Его теория крутилась у меня в голове всю ночь: а вдруг кто-то из Калачей — не человек?"
    "Я посмотрел на свой список чатов. Все шестеро были «в сети». Одновременно. В четыре утра."
    return
