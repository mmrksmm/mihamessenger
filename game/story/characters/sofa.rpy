label sofa_day1:
    me "«Ничто так не сплачивает команду, как общая победа». Неизвестный мудрец."
    sofa "Ты что, флиртовать удумал?"
    sofa "Даже не пиши мне!"
    me "Я просто хотел поздороваться."
    sofa "Хм. А ты, значит, начитанный?"
    sofa "Я тоже немножко читаю. Визуальные новеллы считаются?"
    sofa "Б-боже, почему я рассказываю это тебе?!"
    me "Ты, наверное, фанатка всяких фандомов?"
    sofa "Такое нельзя говорить девушке!"
    think "Если бы Калачи были героинями новеллы, Софа была бы классической цундере."
    sofa "О чём ты там думаешь с таким глупым лицом?"
    think "Это же просто шутка? У приложения ведь нет доступа к камере?.."
    sofa "И вообще, мне не платят за общение с тобой!"
    sofa "Пойду поем. Хотя эклеры, кажется, уже всё."

    menu:
        "«Выкидывай эклеры и не ной»":
            me "Выкидывай эклеры и не ной."
            sofa "Ч-что?! Сам не ной!"
            sofa "Я, между прочим, администратор!"
            call fade_out_chat from _call_fade_out_chat_11
            think "Больше Софа в тот вечер не выходила на связь."
            think "Может, стоит быть помягче?"

        "Отправить ей стикер-печенье":
            $ like("sofa")
            me "{image=sticker_cookie}"
            me "Держи. Виртуальное, но от души."
            sofa "Это что, мне?"
            sofa "В-влад, это так глупо…"
            sofa "Но спасибо. Ты иногда бываешь не таким уж плохим."
            call fade_out_chat from _call_fade_out_chat_12
            think "Кажется, Софа покраснела. Я это прямо чувствую."
    return


label sofa_day2:
    think "Софа — администратор. Если кто и знает правду, то она."
    me "С-Софа, г-где Сглыпа?"
    sofa "Что за сопли, Влад? Как маленький."
    me "Я правда переживаю."
    sofa "Боже, вечно тебя успокаивать…"
    sofa "Всё в порядке. Сглыпу просто замьютили ради пранка."
    sofa "Спокоен?"
    me "А кто тогда оставил записку?"
    sofa "Записку? Любовное письмо, что ли?"
    sofa "И ты думаешь, что это я?! Совсем с ума сошёл!"
    think "Если даже Софа не знает, то что говорить о других?"

    menu:
        "Сменить тему и скинуть ей любимый трек":
            me "Ладно, забудь. Лучше послушай, какую песню я нашёл!"
            sofa "Влад, у нас тут человек пропал, а ты с песнями."
            sofa "Ну, то есть бот. Но всё равно!"
            call fade_out_chat from _call_fade_out_chat_13
            think "Кажется, момент был выбран неудачно."

        "Промолчать и просто побыть рядом":
            $ like("sofa")
            think "Я просто сидел и смотрел в экран."
            sofa "В-Влад, хочешь посмотреть мой симс?"
            sofa "Я сделаю персонажа как ты и как я…"
            sofa "Н-не подумай ничего, это просто ради смеха!!"
            sofa "Просто интересно, как бы мы смотрелись вместе."
            me "Давай."
            call fade_out_chat from _call_fade_out_chat_14
            think "Несколько часов мы наблюдали, как наши симы пытаются ужиться в одном доме."
            think "Софа так и не разобралась, как строить стены. Мы смеялись до ночи."
    return


label sofa_final:
    me "Софа!"
    me "Я выбираю тебя."
    sofa "Что?.."
    sofa "Влад, ты совсем?"
    think "Софа строгая, громкая и вечно делает вид, что я ей неинтересен."
    think "Но за этим прячется очень добрый человек."
    me "Ты единственная, кто всё это время был со мной честен."

    if has_max_affection("sofa"):
        sofa "Я…"
        sofa "Я тоже рада, что ты появился в нашем чате, дурацкий Влад"
        sofa "Держи. Только никому не говори"
        system "кшктрикс назначила вас администратором чата «Тёртые калачи»"
        me "Софа!"
        sofa "Теперь будешь вместе со мной следить за порядком. И за Сглыпой"
    else:
        sofa "Влад, прости, мне некогда"
        sofa "Я в электричке"
        sofa "Тут связь плохая"
        system "кшктрикс не в сети"
    return


label sofa_good:
    scene ending sofa_good with Dissolve(2.0)
    pause 1.5
    think "Вдвоём мы навели в «Калачах» порядок: никаких пранков с пропажами, никаких жутких опросов."
    think "Первым делом мы отобрали у Сглыпы доступ к камерам."
    think "А по вечерам смотрим, как наши симы строят дом. С каждым разом у них получается всё лучше."
    return


label sofa_bad:
    scene ending sofa_bad with Dissolve(2.0)
    pause 1.5
    "Софа уехала на электричке."
    "Куда — она так и не написала."
    "Чат «Тёртые калачи» остался без администратора, а я — без ответов."
    return
