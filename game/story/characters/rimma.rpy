label rimma_day1:
    me "Привет."
    rimma "привет, владик"
    me "Ты хотела комикс по ролям?"
    me "А какой комикс?"
    rimma "хех. тебе лучше не знать"
    rimma "там восемь тысяч страниц. не каждый осилит"
    me "Ради тебя я готов на всё."
    rimma "{image=sticker_heart}"
    rimma "хотя нет. давай лучше что-нибудь другое"
    me "Например?"

    menu:
        "«Давай всё-таки комикс по ролям»":
            $ like("rimma")
            me "Давай всё-таки комикс. Я справлюсь."
            rimma "угадал"
            rimma "ладно. но это будет нашей маленькой тайной"
            stop music fadeout 2.0
            rimma "а если кто-то узнает…"
            play music tense
            rimma "все узнают, что ты тоже кое-что скрываешь. да, владик?"
            think "О… о чём это она?"
            me "?"
            rimma "договорились. хех"
            stop music fadeout 1.5
            call fade_out_chat from _call_fade_out_chat_4
            think "До глубокой ночи Римма рассказывала мне про персонажей комикса."
            think "Их было очень, очень много."
            play music calm fadein 3.0

        "«Может, тайкун про плюшевых монстриков?»":
            if vlad_threw_out_toy:
                think "Хотя нет. С плюшевыми монстриками покончено."
                me "Ладно, забудь. С монстриками я завязал."
                rimma "…"
                rimma "правильно сделал, что выбросил того, с полки"
                think "Но как она могла узнать?!"
                rimma "ещё увидимся"
                call fade_out_chat from _call_fade_out_chat_5
                think "После этого Римма загадочно пропала из сети."
            else:
                me "Может, тайкун про плюшевых монстриков?"
                rimma "…"
                rimma "не ожидала от тебя, влад"
                me "А что в этом плохого?"
                play music tense
                rimma "ничего. особенно про того монстрика у тебя на полке"
                think "Но как она могла узнать?!"
                rimma "ещё увидимся"
                call fade_out_chat from _call_fade_out_chat_6
                think "После этого Римма загадочно пропала из сети."
                play music calm fadein 3.0
    return


label rimma_day2:
    me "Римма, можешь говорить?"
    rimma "что такое"
    rimma "я всегда рядом"
    think "Рядом с ней спокойно. Но сейчас я никому не могу доверять."
    me "Что на самом деле случилось со Сглыпой?"
    rimma "тебе же сказали. пранк"
    me "Тогда почему он молчит?"
    rimma "нечего сказать. бывает"
    rimma "пойдём лучше в симс поиграем. отвлечёшься"

    menu:
        "Пойти играть в симс":
            $ like("rimma")
            me "Ладно. Отвлечься не помешает."
            rimma "вот и умница"
            think "Мне правда стало спокойнее. Я даже улыбнулся."
            rimma "хех, как ты мило улыбаешься"
            me "?!"
            think "Опять! Откуда она знает?"
            "На эмоциях я заклеил камеру ноутбука."
            rimma "это не поможет"
            rimma "я всё равно тебя вижу"
            me "Римма… не пугай меня."
            rimma "так что, симс?"
            call fade_out_chat from _call_fade_out_chat_7
            "Весь вечер мы играли в симс. Римма почему-то всё время смотрела в окно."

        "Отказаться":
            me "Извини, у меня сегодня другие дела."
            rimma "какие это"
            rimma "ладно. подумай над своим поведением"
            rimma "я проверю"
            think "Мне стоит её бояться?.."
            pause 2.0
            me "Римма?"
            me "Ответь!"
            call fade_out_chat from _call_fade_out_chat_8
            "Сколько я ни писал, ответа не было."
    return


label rimma_final:
    me "Римма!"
    me "Я выбираю тебя."
    rimma "владик?"
    rimma "ты о чём"
    think "Римма загадочная, молчаливая и пугающе внимательная."
    think "Но именно этим она мне и нравится."
    me "Я хотел сказать это с самого начала. Мне с тобой спокойно."

    if has_max_affection("rimma"):
        rimma "подойди к окну"
        me "Зачем?"
        rimma "просто подойди"
        "Я подошёл. В доме напротив, в окне третьего этажа, кто-то помахал мне рукой."
        rimma "привет, сосед"
        rimma "и да. записку оставила я. прости, не удержалась"
    else:
        rimma "понятно"
        rimma "спокойной ночи, владик"
        system "hau999 скрыла время последнего визита"
    return


label rimma_good:
    scene ending rimma_good with Dissolve(2.0)
    pause 1.5
    think "Всё оказалось проще, чем я думал. Римма живёт в доме напротив."
    think "Половину «слежки» она просто видела в окно, а остальное ей пересказывал Сглыпа."
    think "Теперь мы каждый вечер машем друг другу, а по выходным читаем тот самый бесконечный комикс."
    think "Рядом с ней я как за каменной стеной."
    return


label rimma_bad:
    scene ending rimma_bad with Dissolve(2.0)
    pause 1.5
    "На следующее утро в окне дома напротив плотно задёрнули шторы."
    "Больше они не открывались."
    "А я так и не узнал, кто оставил записку."
    return
